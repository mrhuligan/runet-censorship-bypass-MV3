{
  "manifest_version": 3,

  "name": "__MSG_extName__",
  "default_locale": "ru",
  "description": "__MSG_extDesc__",
  "version": "0.0.${version}",
  "icons": {
    "128": "icons/default-128.png"
  },
  "author": "mrhuligan",
  "homepage_url": "https://github.com/mrhuligan/runet-censorship-bypass-MV3",

  "permissions": [
      "proxy"
    , "alarms"
    , "storage"
    , "unlimitedStorage"
    , "tabs"
    , "contextMenus"
    , "notifications"
    , "webNavigation"
    ${extra_permissions}
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "102.0.0.0",
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "109.0"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Этот сайт благословлён | Версия ${version + versionSuffix}",
    "default_popup": "/pages/options/index.html",
    "default_icon": {
      "128": "icons/default-128.png"
    }
  },
  "options_ui": {
     "page": "/pages/options/index.html",
     "open_in_tab": true
   }

}
